#!/usr/bin/env bash
set -euo pipefail

: "${VALHEIM_SERVER_NAME:?missing VALHEIM_SERVER_NAME}"
: "${VALHEIM_WORLD_NAME:?missing VALHEIM_WORLD_NAME}"
: "${VALHEIM_PASSWORD:?missing VALHEIM_PASSWORD}"
: "${VALHEIM_PORT:=2456}"
: "${VALHEIM_PUBLIC:=1}"
: "${VALHEIM_CROSSPLAY:=0}"
: "${VALHEIM_MODDED:=0}"
: "${VALHEIM_PORTALS:=}"
: "${VALHEIM_SKILL_GAIN_RATE:=}"
: "${VALHEIM_SKILL_REDUCTION_RATE:=}"
: "${VALHEIM_SERVER_DIR:=/opt/valheim/server}"

cd "$VALHEIM_SERVER_DIR"

args=(
  -name "$VALHEIM_SERVER_NAME"
  -port "$VALHEIM_PORT"
  -world "$VALHEIM_WORLD_NAME"
  -password "$VALHEIM_PASSWORD"
  -public "$VALHEIM_PUBLIC"
  -savedir /var/lib/valheim
)

if [[ "$VALHEIM_CROSSPLAY" == "1" ]]; then
  args+=(-crossplay)
fi

if [[ -n "$VALHEIM_PORTALS" ]]; then
  case "$VALHEIM_PORTALS" in
    casual | hard | veryhard) ;;
    *)
      echo "Invalid VALHEIM_PORTALS: expected casual, hard, veryhard, or empty." >&2
      exit 1
      ;;
  esac
  args+=(-modifier portals "$VALHEIM_PORTALS")
fi

append_rate_key() {
  local variable_name=$1
  local key=$2
  local value=$3

  if [[ -z "$value" ]]; then
    return
  fi
  if [[ ! "$value" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "Invalid $variable_name: expected a non-negative percentage or empty." >&2
    exit 1
  fi
  args+=(-setkey "$key $value")
}

append_rate_key VALHEIM_SKILL_GAIN_RATE skillgainrate "$VALHEIM_SKILL_GAIN_RATE"
append_rate_key VALHEIM_SKILL_REDUCTION_RATE skillreductionrate "$VALHEIM_SKILL_REDUCTION_RATE"

if [[ "$VALHEIM_MODDED" == "1" ]]; then
  required_mod_files=(
    ./BepInEx/core/BepInEx.Preloader.dll
    ./doorstop_libs/libdoorstop_x64.so
  )
  for required_file in "${required_mod_files[@]}"; do
    if [[ ! -f "$required_file" ]]; then
      echo "Modded launch requested, but $required_file is missing." >&2
      exit 1
    fi
  done

  export DOORSTOP_ENABLED=1
  export DOORSTOP_TARGET_ASSEMBLY=./BepInEx/core/BepInEx.Preloader.dll
  export LD_LIBRARY_PATH="./doorstop_libs:${LD_LIBRARY_PATH:-}"
  export LD_PRELOAD="libdoorstop_x64.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi

export LD_LIBRARY_PATH="./linux64:${LD_LIBRARY_PATH:-}"
export SteamAppId=892970

echo "[diag][Server] launch modded=$VALHEIM_MODDED portals=${VALHEIM_PORTALS:-default} skill_gain=${VALHEIM_SKILL_GAIN_RATE:-default} skill_loss=${VALHEIM_SKILL_REDUCTION_RATE:-default} crossplay=$VALHEIM_CROSSPLAY public=$VALHEIM_PUBLIC port=$VALHEIM_PORT"
exec ./valheim_server.x86_64 "${args[@]}"

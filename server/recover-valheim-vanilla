#!/usr/bin/env bash
set -euo pipefail

env_file=${VALHEIM_ENV_FILE:-/etc/valheim/server.env}
systemctl_bin=${SYSTEMCTL_BIN:-systemctl}
wait_ready=${VALHEIM_WAIT_READY:-/usr/local/bin/valheim-wait-ready}
unit=${VALHEIM_SYSTEMD_UNIT:-valheim.service}

if ! "$systemctl_bin" stop "$unit"; then
  echo "Warning: Valheim was already stopped or could not be stopped during recovery." >&2
fi

if grep -q '^VALHEIM_MODDED=' "$env_file"; then
  sed -i.benheim-recovery "s/^VALHEIM_MODDED=.*/VALHEIM_MODDED=0/" "$env_file"
  rm -f "$env_file.benheim-recovery"
else
  printf '\nVALHEIM_MODDED=0\n' >> "$env_file"
fi

started_at=${VALHEIM_RECOVERY_STARTED_AT:-$(date --iso-8601=seconds)}
"$systemctl_bin" start "$unit"
"$wait_ready" "$started_at"

echo "Vanilla recovery reached readiness."

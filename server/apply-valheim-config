#!/usr/bin/env bash
set -euo pipefail

keep_stopped=${1:?Usage: apply-valheim-config KEEP_STOPPED [WORK_DIRECTORY]}
work=${2:-/tmp/valheim-server-config}
root=${VALHEIM_CONFIG_ROOT:-}
env_path="$root/etc/valheim/server.env"
launcher_path="$root/usr/local/bin/valheim-start"
waiter_path="$root/usr/local/bin/valheim-wait-ready"
backup_command=${VALHEIM_BACKUP_COMMAND:-valheim-backup-and-upload}

install_runtime_env() {
  local source=$1
  if [[ -z "$root" ]]; then
    install -m 0640 -o root -g valheim "$source" "$env_path"
  else
    install -m 0640 "$source" "$env_path"
  fi
}

case "$keep_stopped" in
  0|1) ;;
  *) echo "KEEP_STOPPED must be 0 or 1." >&2; exit 1 ;;
esac

cleanup_stage() {
  rm -rf "$work"
}
old_env="$work/server.env.previous"
old_launcher="$work/valheim-start.previous"
old_waiter="$work/wait-for-valheim.previous"
was_active=0
if systemctl is-active --quiet valheim.service; then
  was_active=1
fi
cp "$env_path" "$old_env"
cp "$launcher_path" "$old_launcher"
cp "$waiter_path" "$old_waiter"

recover_previous() {
  local status=$?
  if [[ $status -ne 0 ]]; then
    echo "Config deployment failed; restoring the previous launcher and environment." >&2
    systemctl stop valheim.service || true
    install_runtime_env "$old_env"
    install -m 0755 "$old_launcher" "$launcher_path"
    install -m 0755 "$old_waiter" "$waiter_path"
    if (( was_active == 1 )); then
      systemctl start valheim.service || true
    fi
  fi
  cleanup_stage
  exit "$status"
}
trap recover_previous EXIT

systemctl stop valheim.service
"$backup_command"
install_runtime_env "$work/server.env"
install -m 0755 "$work/valheim-start" "$launcher_path"
install -m 0755 "$work/wait-for-valheim" "$waiter_path"
if (( keep_stopped == 0 )); then
  started_at="$(date --iso-8601=seconds)"
  systemctl start valheim.service
  "$waiter_path" "$started_at"
fi

trap - EXIT
cleanup_stage
if (( keep_stopped == 1 )); then
  echo "Applied server configuration; valheim.service remains stopped."
else
  echo "Applied server configuration."
fi

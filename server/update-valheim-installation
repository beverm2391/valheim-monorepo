#!/usr/bin/env bash
set -euo pipefail

# Bootstrap and the routine operator share this one stable SteamCMD command.
# The routine operator owns approval, save/stop, backups and recovery.
if systemctl is-active --quiet valheim.service ||
   [[ $(systemctl show valheim.service --property=MainPID --value 2>/dev/null || true) =~ ^[1-9][0-9]*$ ]]; then
  echo 'Refusing to update a running server; use scripts/update-server.sh --restart-approved.' >&2
  exit 1
fi
exec sudo -u valheim /usr/games/steamcmd +force_install_dir /opt/valheim/server +login anonymous +app_update 896660 validate +quit

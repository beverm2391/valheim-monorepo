# Copy to server.env and edit.
#
# Keep credentials in the process environment, not this file. The scripts
# reject named secret assignments before sourcing server.env.

# Hetzner
# HCLOUD_CONTEXT=valheim
HETZNER_SERVER_NAME=valheim
HETZNER_LOCATION=ash
HETZNER_SERVER_TYPE=cpx21
HETZNER_IMAGE=ubuntu-24.04
HETZNER_SSH_KEY=

# Valheim
VALHEIM_SERVER_NAME=Valheim
VALHEIM_WORLD_NAME=world
VALHEIM_PORT=2456
VALHEIM_PUBLIC=1
VALHEIM_CROSSPLAY=0
VALHEIM_MODDED=0
VALHEIM_PORTALS=
VALHEIM_SKILL_GAIN_RATE=
VALHEIM_SKILL_REDUCTION_RATE=
VALHEIM_BACKUP_PREFIX=valheim

# Optional failure forwarding into the same Axiom dataset used by managed
# Benheim clients. The full systemd journal remains the server's raw log.
# Inject BENHEIM_AXIOM_INGEST_TOKEN in the process environment when enabled.
VALHEIM_DIAGNOSTICS_CONFIGURE=0
BENHEIM_AXIOM_ENDPOINT=https://us-east-1.aws.edge.axiom.co
BENHEIM_AXIOM_DATASET=
VALHEIM_DIAGNOSTICS_SERVER_ID=valheim

# Optional Cloudflare R2 target. These are non-secret routing settings; inject
# VALHEIM_R2_ACCESS_KEY_ID and VALHEIM_R2_SECRET_ACCESS_KEY in the process
# environment when R2 is enabled.
VALHEIM_R2_CONFIGURE=0
VALHEIM_R2_ACCOUNT_ID=
VALHEIM_R2_BUCKET=valheim-backups
VALHEIM_R2_PREFIX=benheim

# Local SSH
SSH_USER=root
SSH_HOST=
SSH_KEY_PATH=

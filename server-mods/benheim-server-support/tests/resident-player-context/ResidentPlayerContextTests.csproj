<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ValheimGameDir Condition="'$(ValheimGameDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim</ValheimGameDir>
    <ValheimManagedDir>$(ValheimGameDir)/valheim.app/Contents/Resources/Data/Managed</ValheimManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ResidentPlayerContext.cs" Link="ResidentPlayerContext.cs" />
    <Compile Include="../../src/ResidentPlayerProfiles.cs" Link="ResidentPlayerProfiles.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ValheimManagedDir)/Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>

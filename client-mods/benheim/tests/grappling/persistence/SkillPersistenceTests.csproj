<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ValheimGameDir Condition="'$(ValheimGameDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim</ValheimGameDir>
    <ValheimManagedDir>$(ValheimGameDir)/valheim.app/Contents/Resources/Data/Managed</ValheimManagedDir>
    <BepInExCoreDir>$(ValheimGameDir)/BepInEx/core</BepInExCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Grappling/GrapplingSkill.cs" Link="GrapplingSkill.cs" />
    <Reference Include="assembly_valheim"><HintPath>$(ValheimManagedDir)/assembly_valheim.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ValheimManagedDir)/assembly_guiutils.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ValheimManagedDir)/assembly_utils.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManagedDir)/UnityEngine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
